# Railway production (set these in the service Variables tab)
# DATABASE_URL=file:/data/branner.db
# SESSION_SECRET=<openssl rand -hex 32>
# ADMIN_EMAILS=hoyoon@stanford.edu
# GOOGLE_CLIENT_ID=<from Google Cloud OAuth client>
# GOOGLE_CLIENT_SECRET=<from Google Cloud OAuth client>
# Leave GOOGLE_CALLBACK_URL empty to use https://$RAILWAY_PUBLIC_DOMAIN/api/auth/google/callback
# PUBLIC_URL=https://branner.hoyoonsong.com
# ALLOW_DEV_LOGIN=0
# DATA_DIR=/data
